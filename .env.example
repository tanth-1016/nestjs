# Server Configuration
# Example: PORT=8080
PORT=3000

# Environment
# Values: development | test | production
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Use a unique password per environment. Do not use this placeholder in production.
DB_PASSWORD=change-me
DB_NAME=notejs_tutorial
# Generate a strong, unique JWT secret for each environment.
JWT_SECRET=generate-a-secure-secret
# JWT access token lifetime (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN=15m